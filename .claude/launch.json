{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "GitHub Pages (静的サイト)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", ".", "--listen", "3000"],
      "port": 3000
    },
    {
      "name": "シナリオエディタ (Electron)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "cwd": "../シナリオエディタ",
      "port": null
    },
    {
      "name": "Excel関数リファレンス (静的サイト)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "../Excel関数リファレンス", "--listen", "3001"],
      "port": 3001
    },
    {
      "name": "3Dボックスビューア (静的サイト)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "../3d-box-viewer", "--listen", "3002"],
      "port": 3002
    }
  ]
}
